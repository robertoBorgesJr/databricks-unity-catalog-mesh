# Copie este arquivo para .env e preencha com suas credenciais locais.
# NUNCA comite o arquivo .env no repositório.

# Domínio Sales
SALES_DATABRICKS_HOST=https://<workspace-id>.azuredatabricks.net
SALES_DATABRICKS_TOKEN=<seu-token-pessoal-ou-service-principal>
SALES_DATABRICKS_CLUSTER_ID=<cluster-id-sales>

# Domínio Marketing
MARKETING_DATABRICKS_HOST=https://<workspace-id>.azuredatabricks.net
MARKETING_DATABRICKS_TOKEN=<seu-token-pessoal-ou-service-principal>
MARKETING_DATABRICKS_CLUSTER_ID=<cluster-id-marketing>

# Ambiente local
ENVIRONMENT=dev
